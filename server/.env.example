# Copy to ".env" and fill in. NEVER commit the real .env.

PORT=4242
SITE_URL=http://localhost:4242
CORS_ORIGIN=*                       # or your Pages URL, e.g. https://salim-baig.github.io

# ---- Staff auth (Admin/POS + Orders API) ----
STAFF_PASSCODE=millwoods2026
SERVER_SECRET=please-change-this-long-random-string

# ---- Store alert email ----
STORE_EMAIL=orders@millwoodshalal.ca

# ---- SMTP for sending receipts/alerts (e.g. Gmail app password) ----
# Leave SMTP_HOST blank to disable email (orders still save).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Millwoods Halal <orders@millwoodshalal.ca>"

# ---- Stripe ----  https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ---- Square ----  https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox
