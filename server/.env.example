# Copy this file to ".env" and fill in the keys for whichever
# provider you use. NEVER commit your real .env file.

PORT=4242
# Where the static site is served from (for Stripe success/cancel redirects)
SITE_URL=http://localhost:9000

# ---- Stripe ----  https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# ---- Square ----  https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=xxx
SQUARE_LOCATION_ID=xxx
SQUARE_ENV=sandbox        # sandbox | production
